async function notificarLocal(title,body,url,tag){
  if(!("serviceWorker" in navigator)||Notification.permission!=="granted")return;
  if(document.visibilityState==="visible"&&$("widget")?.classList.contains("open"))return;
  try{
    const reg=await navigator.serviceWorker.ready;
    reg.showNotification(title,{body,icon:"/icons/icon-192.png",badge:"/icons/badge-72.png",
      tag:tag||"bet300",renotify:true,data:{url:url||"/"},vibrate:[200,80,200]});
  }catch(e){}
}

function chequearPendienteViejo(){
  if(!tieneSolicitudPendiente())return;
  const started=Number(state.solicitudStartedAt||localStorage.getItem("bet300_solicitud_started_at")||0);
  if(!started)return;
  const hs=(Date.now()-started)/3600000;
  if(hs<24)return;
  setTimeout(()=>toast(`Tu solicitud lleva +${Math.round(hs)}h. Si ya fue procesada, marcala como resuelta en Estado.`),3000);
}

document.addEventListener("keydown",e=>{
  if(e.key==="Escape"&&$("widget")?.classList.contains("open")){toggleWidget(false);return;}
  if(e.target.id!=="freeInput")return;
  if(e.key==="Enter"&&!e.shiftKey){e.preventDefault();sendFreeMessage();}
});

document.addEventListener("paste",e=>{
  if(state.screen!=="chat")return;
  const items=[...(e.clipboardData?.items||[])];
  const imgItem=items.find(it=>it.type.startsWith("image/"));
  if(!imgItem)return;
  e.preventDefault();
  const file=imgItem.getAsFile();
  if(!file)return;
  state.composerImage=file;
  const thumb=$("imgPreviewThumb"),nom=$("imgPreviewName"),bar=$("imgPreviewBar");
  if(!bar)return;
  nom.textContent="Imagen pegada del portapapeles";
  thumb.src=URL.createObjectURL(file);
  thumb.style.display="";
  bar.classList.remove("hidden");
});

function marcarAppInstalada(){
  try{
    const standalone = (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) || window.navigator.standalone === true;
    if(standalone && state.usuario && state.pcCodigo){
      rpc("landing_marcar_app_instalada",{p_pc_codigo:state.pcCodigo,p_usuario:state.usuario});
    }
  }catch(_e){}
}
window._deferredInstallPrompt=null;
window.addEventListener('beforeinstallprompt', function(ev){ ev.preventDefault(); window._deferredInstallPrompt=ev; });
window.addEventListener('appinstalled', function(){
  window._deferredInstallPrompt=null;
  try{ localStorage.setItem("bet300_app_instalada","1"); }catch(_e){}
  try{ if(state.usuario && state.pcCodigo) rpc("landing_marcar_app_instalada",{p_pc_codigo:state.pcCodigo,p_usuario:state.usuario}); }catch(_e){}
  try{ if(state.screen==="home") renderHome(); }catch(_e){}
});

function mostrarActualizarPWA(reg){
  if(document.getElementById("swUpdateBanner"))return;
  const b=document.createElement("div");
  b.id="swUpdateBanner";
  b.style.cssText="position:fixed;left:12px;right:12px;bottom:calc(14px + var(--safe-b));z-index:99999;background:#11203a;border:1px solid var(--gold-deep);border-radius:14px;padding:12px 14px;display:flex;align-items:center;gap:10px;box-shadow:0 12px 34px rgba(0,0,0,.55)";
  b.innerHTML='<div style="flex:1;font-size:13px;font-weight:700;color:#eaf2ff;line-height:1.35">🔄 Hay una versión nueva del cajero.</div>'
    +'<button id="swUpdBtn" style="background:var(--gold);color:#1a1500;border:none;border-radius:10px;padding:9px 15px;font-weight:800;cursor:pointer;flex-shrink:0">Actualizar</button>';
  document.body.appendChild(b);
  document.getElementById("swUpdBtn").onclick=function(){
    window._swWillReload=true; this.textContent="Actualizando…"; this.disabled=true;
    try{ if(reg&&reg.waiting) reg.waiting.postMessage({type:"SKIP_WAITING"}); else window.location.reload(); }
    catch(_e){ window.location.reload(); }
  };
}
function _reanudarPollsVisibles(){
  const abierto = $("widget")?.classList.contains("open");
  if(abierto){
    if(state.chatId) startChatPoll();
    if(state.usuario) startPortalThreadPoll();
  }
  if(tieneSolicitudPendiente()) startEstadoPoll();
}
document.addEventListener("visibilitychange",()=>{
  if(document.visibilityState==="hidden"){ stopChatPoll(); stopPortalThreadPoll(); stopEstadoPoll(); }
  else { _reanudarPollsVisibles(); }
});
window.addEventListener("load",async()=>{
  if("serviceWorker" in navigator){
    navigator.serviceWorker.register("/sw.js").then(reg=>{
      if(reg.waiting && navigator.serviceWorker.controller) mostrarActualizarPWA(reg);
      reg.addEventListener("updatefound",()=>{
        const nw=reg.installing; if(!nw)return;
        nw.addEventListener("statechange",()=>{
          if(nw.state==="installed" && navigator.serviceWorker.controller) mostrarActualizarPWA(reg);
        });
      });
      setInterval(()=>{ reg.update().catch(()=>{}); }, 60*60*1000);
      document.addEventListener("visibilitychange",()=>{ if(document.visibilityState==="visible") reg.update().catch(()=>{}); });
    }).catch(e=>console.warn("[SW]",e));
    navigator.serviceWorker.addEventListener("controllerchange",()=>{ if(window._swWillReload) window.location.reload(); });
  }
  try{ const _af=$("appFrame"); if(_af && (!_af.getAttribute("src") || _af.getAttribute("src")==="about:blank")) _af.src=PLATFORM_URL; }catch(_e){}
  restoreLauncherMini();
  await initRoute();
  const acceso = await canjearEnlaceAcceso();
  await cargarPromoActiva();
  setTimeout(marcarAppInstalada, 2500);
  renderHome();
  showScreen("home");
  if(acceso && (acceso.destino==="CARGAR" || acceso.destino==="RETIRAR")){
    try{ toggleWidget(true); }catch(_e){}
    try{ if(acceso.destino==="CARGAR") goCarga(); else goRetiro(); }catch(_e){}
  }
  if(tieneSolicitudPendiente()){
    startEstadoPoll();
    chequearPendienteViejo();
  }
});
</script>
