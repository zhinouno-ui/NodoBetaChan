const TITULAR_MIN_LETRAS=3;

function _soloLetras(v){
  return String(v||"")
    .replace(/[^\p{L}\s]/gu,"")   // fuera todo lo que no sea letra o espacio
    .replace(/\s{2,}/g," ")       // espacios repetidos → uno
    .replace(/^\s+/,"");          // sin espacio al principio (el del final se deja: está tipeando)
}
function _normComparar(v){
  return String(v||"").toLowerCase().normalize("NFD")
    .replace(/[̀-ͯ]/g,"").replace(/[^a-z0-9]/g,"");
}
function _datosPropiosNormalizados(){
  const b=state.billetera||{};
  return [b.titular,b.alias,b.cbu,b.cvu,b.nombre_visible,b.nombre]
    .map(_normComparar).filter(function(x){ return x && x.length>=4; });
}
function validarTitular(valor){
  const v=String(valor||"").trim();
  const letras=v.replace(/[^\p{L}]/gu,"");
  if(letras.length<TITULAR_MIN_LETRAS) return "Escribí el nombre y apellido de la cuenta desde la que transferiste.";
  const n=_normComparar(v), propios=_datosPropiosNormalizados();
  for(const p of propios){
    if(n===p || (n.length>=6 && p.indexOf(n)>=0) || (p.length>=6 && n.indexOf(p)>=0)){
      return "Ese es el titular de NUESTRA cuenta. Poné el nombre de la cuenta desde la que vos transferiste.";
    }
  }
  const _uNorm=_normComparar(state.usuario||"");
  const _uLetras=String(state.usuario||"").replace(/[^\p{L}]/gu,"").toLowerCase()
    .normalize("NFD").replace(/[̀-ͯ]/g,"");
  for(const u of [_uNorm,_uLetras]){
    if(!u || u.length<3) continue;
    if(n===u || (u.length>=4 && n.indexOf(u)>=0) || (n.length>=5 && u.indexOf(n)>=0)){
      return "Ese es tu usuario de juego, no el titular. Poné el nombre y apellido de la cuenta bancaria.";
    }
  }
  return "";
}
function _titularEsNuestro(titular){
  const t = String(titular||"").toLowerCase().replace(/[^a-z0-9]/g, "");
  if(t.length < 3) return false;
  const b = state.billetera || {};
  const propios = [b.titular, b.alias, b.cbu, b.cvu, b.nombre_visible, b.nombre]
    .map(function(v){ return String(v||"").toLowerCase().replace(/[^a-z0-9]/g, ""); })
    .filter(function(v){ return v.length >= 3; });
  return propios.some(function(v){ return v === t || v.indexOf(t) !== -1 || t.indexOf(v) !== -1; });
}

async function _titularBloqueado(titular){
