let _ipCache=null, _ipPedida=false;
async function _ipPublica(){
  if(_ipCache!==null) return _ipCache;
  if(_ipPedida) return null;              // ya hay una en vuelo: no encolar otra
  _ipPedida=true;
  try{
    const ctrl=new AbortController();
    const t=setTimeout(function(){ ctrl.abort(); }, 2500);   // no bloquear el envío
    const r=await fetch("https://api.ipify.org?format=json",{signal:ctrl.signal});
    clearTimeout(t);
    const d=await r.json();
    _ipCache=String((d&&d.ip)||"")||null;
  }catch(_e){ _ipCache=null; }
  return _ipCache;
}

function _infoNavegador(){
  try{
    const ua=navigator.userAgent||"";
    let n="Navegador";
    if(/SamsungBrowser/i.test(ua)) n="Samsung Internet";
    else if(/Edg[A-Z]?\//i.test(ua)) n="Edge";
    else if(/OPR\/|Opera/i.test(ua)) n="Opera";
    else if(/CriOS|Chrome/i.test(ua)) n="Chrome";
    else if(/FxiOS|Firefox/i.test(ua)) n="Firefox";
    else if(/Safari/i.test(ua)) n="Safari";
    let os="";
    if(/iPhone|iPad|iPod/i.test(ua)) os="iOS";
    else if(/Android/i.test(ua)) os="Android";
    else if(/Windows/i.test(ua)) os="Windows";
    else if(/Mac OS X|Macintosh/i.test(ua)) os="Mac";
    const pwa=((window.matchMedia&&window.matchMedia("(display-mode: standalone)").matches)||navigator.standalone)?" · app":"";
    return (n+(os?" ("+os+")":"")+pwa)||ua.slice(0,120);
  }catch(_e){ return (navigator.userAgent||"").slice(0,120); }
}

