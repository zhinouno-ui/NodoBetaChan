async function subirImagen(file){
  if(!sb||!file)return null;
  const TIPOS_OK=["image/jpeg","image/png","image/webp"];
  const mime=String(file.type||"").toLowerCase();
  if(!TIPOS_OK.includes(mime)){ toast("Solo se aceptan imágenes JPG, PNG o WEBP."); return null; }
  if(file.size>5*1024*1024){ toast("El archivo supera 5 MB"); return null; }
  let blob = await comprimirImagenPortal(file,{maxLado:1280,calidad:0.72});
  let contentType="image/jpeg";
  if(!blob){ blob=file; contentType=mime; }
  const usuarioSan=(state.usuario||"anonimo").replace(/[^a-z0-9_-]/gi,"_");
  const ruta=(state.publicCode||"sin_ruta").replace(/[^a-z0-9_-]/gi,"_");
  const ext = contentType==="image/jpeg" ? "jpg" : ({"image/png":"png","image/webp":"webp"}[contentType]||"jpg");
  const path=`${ruta}/${usuarioSan}/${Date.now()}_${Math.random().toString(36).slice(2,6)}.${ext}`;
  try{
    const{error}=await sb.storage.from("comprobantes").upload(path,blob,{cacheControl:"3600",upsert:false,contentType});
    if(error){console.error("[img upload error]",error.message||error);toast("No se pudo subir la imagen");return null;}
    const{data:urlData}=sb.storage.from("comprobantes").getPublicUrl(path);
    return urlData?.publicUrl||null;
  }catch(e){console.error("[img upload exception]",e);return null;}
}

